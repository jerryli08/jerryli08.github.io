{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=86400" }] },
    { "source": "/assets/models/(.*)", "headers": [{ "key": "Content-Type", "value": "model/gltf-binary" }] }
  ]
}
